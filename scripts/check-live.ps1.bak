# Проверка живости alyaeva.pro. Запускать ПЕРЕД и ПОСЛЕ любых изменений.
# Возвращает 0 если сайт 200 и сертификат валиден, иначе 1.
# ВАЖНО: PS 5.1 съедает %{...} в аргументах — формат передаём через одинарные кавычки с экранированием.
$ErrorActionPreference = 'Stop'
# Docker CLI требует явного контекста при неинтерактивном запуске
$env:DOCKER_HOST   = 'npipe:////./pipe/dockerDesktopLinuxEngine'
$env:DOCKER_CONFIG = 'C:\npc-docker-cfg'
$docker = 'C:\Program Files\Docker\Docker\resources\bin\docker.exe'
$fmt    = '%{http_code}'
$fmtSsl = '%{ssl_verify_result}'
$ok = $true

$code = (& $docker run --rm curlimages/curl:latest -s --max-time 15 -o /dev/null -w $fmt https://alyaeva.pro/) -join ''
Write-Host "HTTPS / -> $code"
if ($code -ne '200') { $ok = $false }

$ver = (& $docker run --rm curlimages/curl:latest -s --max-time 15 -o /dev/null -w $fmtSsl https://alyaeva.pro/) -join ''
Write-Host "SSL verify -> $ver (0 = ок)"
if ($ver -ne '0') { $ok = $false }

$site  = (& $docker inspect alyaeva-site --format '{{.State.Status}}') -join ''
$proxy = (& $docker inspect proxy --format '{{.State.Status}}') -join ''
Write-Host "alyaeva-site=$site proxy=$proxy"
if ($site -ne 'running' -or $proxy -ne 'running') { $ok = $false }

if ($ok) { Write-Host 'OK: сайт жив'; exit 0 }
else { Write-Host 'ALARM: сайт недоступен'; exit 1 }
