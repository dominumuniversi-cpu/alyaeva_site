param([string]$Out = "E:\!Develop\sites\alyaeva\seo\suggest-report.txt")
# Собирает живые подсказки Яндекса по словам-семенам из KEYWORDS.md.
# Запускать раз в 3 месяца; сравнить вывод с KEYWORDS.md.
# Файл ОБЯЗАТЕЛЬНО в UTF-8 с BOM (PS 5.1 иначе читает кириллицу как ANSI).
$seeds = @(
  'книга с именем', 'именная книга для ребенка', 'книга про ребенка на заказ',
  'персональная книга', 'фотокнига екатеринбург', 'подарок на 1 год девочке'
)
$lines = @("SEO-ревизия $(Get-Date -Format 'yyyy-MM-dd HH:mm')", '')
foreach ($s in $seeds) {
  $lines += "## $s"
  try {
    $u = 'https://suggest.yandex.ru/suggest-ff.cgi?part=' + [uri]::EscapeDataString($s) + '&uil=ru'
    $j = Invoke-RestMethod -Uri $u -TimeoutSec 15
    foreach ($x in $j[1]) { $lines += "  " + $x }
  } catch { $lines += '  (ошибка запроса)' }
  $lines += ''
}
$lines += 'Проверить: появились ли новые формулировки, которых нет в KEYWORDS.md'
$lines | Set-Content -Path $Out -Encoding UTF8
Write-Host "Отчёт: $Out"
